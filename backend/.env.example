# Application
NODE_ENV=development
BACKEND_PORT=4000

# Database — direct PostgreSQL connection with pgvector extension installed
DATABASE_URL=postgresql://user:password@localhost:5432/jobpostings

GEMINI_API_KEY=
GEMINI_API_KEY2=

LOCAL_EMBEDDING_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

LLM_MODEL=qwen/qwen3.8-27b
RESUME_PARSER_MODEL=qwen/qwen3.8-27b
JOB_PARSER_MODEL=openai/gpt-oss-120b

JWT_SECRET=your-secret-at-least-16-chars
ADMIN_API_KEY=your-admin-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Ingestion cron schedule (default: every 6 hours)
INGESTION_CRON=0 */6 * * *
# Set to false to freeze the corpus (e.g. for an evaluation snapshot)
INGESTION_CRON_ENABLED=true
INGESTION_PARSE_CONCURRENCY=1

# Vector store serving the app: pgvector | qdrant
VECTOR_BACKEND=pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=job_chunks

FINDWORK_API_KEY=your-findwork-api-key

GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY2=

# Cloudflare R2 storage (resume files; optional outside production)
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
R2_BUCKET_NAME=jobai
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_EXPIRY=3600